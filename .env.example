# ======================================
# GnExpress - Variables d'environnement
# ======================================

# Mode de l'application : development | production
DJANGO_ENV=development

# Clé secrète Django (générer avec: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
SECRET_KEY=your-secret-key-here

# Debug (True en dev, False en prod)
DEBUG=True

# Hôtes autorisés (séparés par des virgules)
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS - Origines autorisées
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ======================================
# BASES DE DONNÉES
# ======================================
# En développement : SQLite (laisser les valeurs par défaut)
# En production : PostgreSQL (renseigner les valeurs ci-dessous)

# Base de données principale (Auth)
DEFAULT_DB_URL=sqlite:///db_auth.sqlite3
# En prod: postgresql://user:password@localhost:5432/gnexpress_auth

# Base de données Livraison
DELIVERY_DB_URL=sqlite:///db_delivery.sqlite3
# En prod: postgresql://user:password@localhost:5432/gnexpress_delivery

# Base de données Marché
MARKET_DB_URL=sqlite:///db_market.sqlite3
# En prod: postgresql://user:password@localhost:5432/gnexpress_market

# Base de données Marketplace
MARKETPLACE_DB_URL=sqlite:///db_marketplace.sqlite3
# En prod: postgresql://user:password@localhost:5432/gnexpress_marketplace

# ======================================
# JWT
# ======================================
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ======================================
# MEDIA
# ======================================
MEDIA_ROOT=media/
MEDIA_URL=/media/

# ======================================
# EMAIL (optionnel)
# ======================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=GnExpress <noreply@gnexpress.gn>
